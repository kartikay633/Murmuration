# Local development values. Copy to .env and keep .env out of git.
DATABASE_URL=postgres://murmuration:murmuration@localhost:5433/murmuration
# Shared by the web app (signs tokens) and the sync server (verifies them).
SYNC_TOKEN_SECRET=change-me-to-a-long-random-string
NEXT_PUBLIC_SYNC_URL=ws://localhost:4001
SYNC_PORT=4001
# Optional: link several sync servers. Leave unset to run one.
# REDIS_URL=redis://localhost:6380
